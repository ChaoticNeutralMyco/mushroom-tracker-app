// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function fieldIn(data, field, values) {
      return hasField(data, field) && data[field] in values;
    }

    function isArchivedGrow(data) {
      return
        (hasField(data, "archived") && data.archived == true) ||
        (hasField(data, "isArchived") && data.isArchived == true) ||
        (hasField(data, "inArchive") && data.inArchive == true) ||
        (hasField(data, "archivedAt") && data.archivedAt != null) ||
        (hasField(data, "archivedOn") && data.archivedOn != null) ||
        (hasField(data, "archived_on") && data.archived_on != null) ||
        (hasField(data, "deleted") && data.deleted == true) ||
        (hasField(data, "deletedAt") && data.deletedAt != null) ||
        fieldIn(data, "status", [
          "Archived", "archived", "ARCHIVED",
          "Contaminated", "contaminated", "CONTAMINATED"
        ]) ||
        fieldIn(data, "stage", [
          "Harvested", "harvested", "HARVESTED",
          "Consumed", "consumed", "CONSUMED",
          "Contaminated", "contaminated", "CONTAMINATED"
        ]) ||
        (
          hasField(data, "amountTotal") &&
          hasField(data, "amountUsed") &&
          data.amountTotal is number &&
          data.amountUsed is number &&
          data.amountTotal > 0 &&
          data.amountUsed >= data.amountTotal
        );
    }

    function isActiveGrow(data) {
      return
        !isArchivedGrow(data) &&
        !fieldIn(data, "status", ["Stored", "stored", "STORED"]) &&
        !fieldIn(data, "stage", ["Harvested", "harvested", "HARVESTED"]) &&
        (
          fieldIn(data, "status", ["Active", "active", "ACTIVE"]) ||
          fieldIn(data, "stage", [
            "Inoculated", "inoculated", "INOCULATED",
            "Colonizing", "colonizing", "COLONIZING",
            "Colonized", "colonized", "COLONIZED",
            "Colonised", "colonised", "COLONISED",
            "Fruiting", "fruiting", "FRUITING"
          ])
        );
    }

    function wouldReactivateGrow() {
      return !isActiveGrow(resource.data) && isActiveGrow(request.resource.data);
    }

    function isPackagedFinishedInventory(data) {
      return
        fieldIn(data, "sourceType", ["finished_package"]) ||
        (
          hasField(data, "packageRunId") &&
          data.packageRunId is string &&
          data.packageRunId.size() > 0
        ) ||
        (
          hasField(data, "package") &&
          data.package is map &&
          hasField(data.package, "isPackaged") &&
          data.package.isPackaged == true
        );
    }

    function packagedFinishedMovementFieldsAreUnchanged() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          "initialQuantity",
          "allocatedQuantity",
          "remainingQuantity",
          "status",
          "outboundSummary",
          "lastOutboundMovementType",
          "lastOutboundMovementDate",
          "destructionSummary",
          "finalDisposition",
          "destroyedAt",
          "archived",
          "isArchived",
          "inArchive",
          "archivedAt",
          "archivedOn",
          "archived_on",
          "deleted",
          "deletedAt"
        ]);
    }

    // SKU identity and FEFO ranking inputs are fixed for an existing package
    // run. This leaves QC, release workflow, shelf-life review, reservation,
    // thresholds, costs and other unrelated operational metadata editable.
    // Date corrections through shelfLife remain allowed; these are an
    // intentional existing QC workflow, not a trusted FEFO audit boundary.
    function packagedFinishedIdentityFieldsAreUnchanged() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          "lotType",
          "inventoryCategory",
          "processType",
          "sourceType",
          "manufacturingStage",
          "packageRunId",
          "sourceLotId",
          "parentLotId",
          "productType",
          "finishedGoodType",
          "productName",
          "strainName",
          "strain",
          "sourceStrain",
          "batchName",
          "name",
          "variantTag",
          "variant",
          "skuType",
          "packageSkuType",
          "packageSizeLabel",
          "packageSize",
          "packageSizeUnit",
          "packageCount",
          "capsulesPerPackage",
          "actualPackageWeightG",
          "totalWeight",
          "bestBy",
          "expirationDate",
          "packDate",
          "createdDate",
          "date"
        ]) &&
        packagedNestedIdentityFieldsAreUnchanged(
          "package",
          [
            "isPackaged",
            "skuType",
            "label",
            "size",
            "unit",
            "count",
            "capsulesPerPackage",
            "actualWeightG",
            "packagedDate"
          ]
        ) &&
        packagedNestedIdentityFieldsAreUnchanged(
          "labelMetadata",
          [
            "productName",
            "skuType",
            "packageSkuType",
            "packageSizeLabel",
            "packageSize",
            "packageSizeUnit",
            "capsulesPerPackage",
            "actualPackageWeightG",
            "totalWeight",
            "bestBy",
            "bestByDate",
            "packDate"
          ]
        );
    }

    // Compare only identity-bearing nested keys. A full-map freeze would
    // break unrelated package/label metadata edits and backup restoration.
    // Unchanged null or legacy values are accepted; malformed replacements
    // cannot silently erase a protected map.
    function packagedNestedIdentityFieldsAreUnchanged(field, identityFields) {
      let before = resource.data.get(field, {});
      let after = request.resource.data.get(field, {});
      return before == after ||
        (
          before is map &&
          after is map &&
          !after.diff(before).affectedKeys().hasAny(identityFields)
        );
    }

    function browserCanUpdateMaterialLot() {
      return
        !isPackagedFinishedInventory(resource.data) ||
        (
          isPackagedFinishedInventory(request.resource.data) &&
          packagedFinishedMovementFieldsAreUnchanged() &&
          packagedFinishedIdentityFieldsAreUnchanged()
        );
    }

    function isAllowedBrowserMaterialDestroy(uid, data) {
      return
        fieldIn(data, "movementType", ["destroy"]) &&
        fieldIn(data, "processType", ["material_inventory"]) &&
        hasField(data, "lotId") &&
        data.lotId is string &&
        exists(
          /databases/$(database)/documents/users/$(uid)/materialLots/$(data.lotId)
        ) &&
        !isPackagedFinishedInventory(
          get(
            /databases/$(database)/documents/users/$(uid)/materialLots/$(data.lotId)
          ).data
        );
    }

    function isTrustedFinishedInventoryMovement(uid, data) {
      return
        fieldIn(data, "processType", ["finished_inventory"]) ||
        fieldIn(data, "movementType", [
          "sell",
          "donate",
          "sample",
          "waste",
          "adjustment"
        ]) ||
        (
          fieldIn(data, "movementType", ["destroy"]) &&
          !isAllowedBrowserMaterialDestroy(uid, data)
        );
    }

    // Deletion checks use the stored record, not caller-supplied replacement
    // data. Keep trusted finished-inventory history immutable, while allowing
    // cleanup of ordinary packaging records and non-packaged material history.
    // An old material-destroy record remains removable if its lot was already
    // deleted, because it cannot have been a valid packaged-destroy record
    // when it was originally created through the browser.
    function browserCanDeleteInventoryMovement(uid, data) {
      return
        !fieldIn(data, "processType", ["finished_inventory"]) &&
        !fieldIn(data, "movementType", [
          "sell",
          "donate",
          "sample",
          "waste",
          "adjustment"
        ]) &&
        (
          !fieldIn(data, "movementType", ["destroy"]) ||
          (
            fieldIn(data, "processType", ["material_inventory"]) &&
            hasField(data, "lotId") &&
            data.lotId is string &&
            (
              !exists(
                /databases/$(database)/documents/users/$(uid)/materialLots/$(data.lotId)
              ) ||
              !isPackagedFinishedInventory(
                get(
                  /databases/$(database)/documents/users/$(uid)/materialLots/$(data.lotId)
                ).data
              )
            )
          )
        );
    }

    function isValidMarketingConsent(data) {
      return
        data.keys().hasOnly([
          "marketingEmailOptIn",
          "email",
          "consentVersion",
          "updatedAt",
          "optedInAt",
          "optedOutAt"
        ]) &&
        data.keys().hasAll([
          "marketingEmailOptIn",
          "email",
          "consentVersion",
          "updatedAt"
        ]) &&
        data.marketingEmailOptIn is bool &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        data.consentVersion == 1 &&
        data.updatedAt is timestamp &&
        (!hasField(data, "optedInAt") ||
          data.optedInAt == null ||
          data.optedInAt is timestamp) &&
        (!hasField(data, "optedOutAt") ||
          data.optedOutAt == null ||
          data.optedOutAt is timestamp);
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      // Subscription entitlements, promotional access grants, the
      // grow-capacity serialization lock, and their user-visible records are
      // readable by the owner but writable only by trusted Firebase Admin
      // backend code.
      match /billing/{document=**} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Marketing/newsletter consent is user-owned and defaults to absent/off.
      // It is intentionally separate from account email verification and from
      // general app preferences. Cross-account/admin access goes through
      // trusted Cloud Functions instead of browser Firestore reads.
      match /communications/{documentId} {
        allow read: if isOwner(uid) && documentId == 'marketing';
        allow create, update:
          if isOwner(uid) &&
             documentId == 'marketing' &&
             isValidMarketingConsent(request.resource.data);
        allow delete: if isOwner(uid) && documentId == 'marketing';
      }

      // All grow creation is trusted-backend-only so browser clients cannot
      // race the active-grow limit. Existing grows remain owner-editable,
      // completable, archivable, storable, and deletable. Only transitions
      // from inactive to active must use the trusted reactivation callable.
      match /grows/{growId} {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid) && !wouldReactivateGrow();
        allow delete: if isOwner(uid);
      }

      // Preserve owner access to any nested grow records without allowing the
      // recursive owner rule below to reopen writes on the grow document.
      match /grows/{growId}/{subcollectionId}/{document=**} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // Packaged finished-inventory movement accounting is authoritative on
      // the trusted backend. Existing package SKU identity and FEFO inputs
      // are also immutable from browsers. QC, release, reservations, shelf
      // life and low-stock controls retain their existing workflows.
      match /materialLots/{lotId} {
        allow read, create: if isOwner(uid);
        // Packaged lots retain their trusted accounting and audit history;
        // generic source/material lots remain owner-deletable.
        allow delete:
          if isOwner(uid) &&
             !isPackagedFinishedInventory(resource.data);
        allow update:
          if isOwner(uid) &&
             browserCanUpdateMaterialLot();
      }

      // Inventory movements remain owner-readable. Trusted finished-inventory
      // sale/distribution/accounting movements are backend-only. Generic
      // final disposition remains browser-writable for non-packaged material
      // because that workflow has not been migrated to the callable boundary.
      match /inventoryMovements/{movementId} {
        allow read: if isOwner(uid);
        // Trusted finished-inventory movement history is append-only for
        // browser users, including the owner. Generic material and packaging
        // cleanup retains its existing deletion path.
        allow delete:
          if isOwner(uid) &&
             browserCanDeleteInventoryMovement(uid, resource.data);

        allow create:
          if isOwner(uid) &&
             !isTrustedFinishedInventoryMovement(
               uid,
               request.resource.data
             );

        allow update:
          if isOwner(uid) &&
             !isTrustedFinishedInventoryMovement(
               uid,
               resource.data
             ) &&
             !isTrustedFinishedInventoryMovement(
               uid,
               request.resource.data
             );
      }

      // Current application data lives under users/{uid}/... . Billing,
      // grows, communications, material lots, and inventory movements are
      // deliberately excluded because they have stricter rules above.
      match /{collectionId}/{document=**} {
        allow read, create, update, delete:
          if isOwner(uid) &&
             collectionId != 'billing' &&
             collectionId != 'grows' &&
             collectionId != 'communications' &&
             collectionId != 'materialLots' &&
             collectionId != 'inventoryMovements';
      }
    }

    // Tester codes and redemption records are private backend data. Browser
    // clients cannot enumerate, read, create, update, or delete them.
    match /testerCodes/{document=**} {
      allow read, write: if false;
    }

    // Internal administrative audit history is backend-only. Even authorized
    // dashboard accounts use trusted Cloud Functions instead of direct client
    // reads or writes to this collection.
    match /internalAdminAudit/{document=**} {
      allow read, write: if false;
    }

    // Optional public reference documents remain read-only.
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny any path that was not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
