# Firebase web configuration
# Firebase web config values are public client identifiers. Security must be enforced
# with Firebase Auth, Firestore/Storage rules, and App Check where enabled.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=chaotic-neutral-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chaotic-neutral-tracker
VITE_FIREBASE_STORAGE_BUCKET=chaotic-neutral-tracker.firebasestorage.app
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Firebase App Check
VITE_FIREBASE_APPCHECK_KEY=
VITE_APPCHECK_DEBUG=0

# Emulator toggles
VITE_USE_FIREBASE_EMULATORS=0
VITE_USE_AUTH_EMULATOR=0

# Emulator ports
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_AUTH_PORT=9099
