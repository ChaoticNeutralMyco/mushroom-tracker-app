// storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
    }

    // Current uploads use owner-scoped paths such as:
    // users/{uid}/photos/...
    // users/{uid}/strains/...
    // users/{uid}/strain-cards/...
    // The recursive owner path also permits the app's account-cleanup flow to
    // list and delete the authenticated user's own stored files.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    // Deny everything outside an authenticated user's own storage tree.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
